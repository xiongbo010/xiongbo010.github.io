#!/usr/bin/env bash

# Shared Ruby setup for local development scripts.
if [[ -x /opt/homebrew/opt/ruby@3.3/bin/ruby ]]; then
  export PATH="/opt/homebrew/opt/ruby@3.3/bin:$PATH"
elif [[ -x /usr/local/opt/ruby@3.3/bin/ruby ]]; then
  export PATH="/usr/local/opt/ruby@3.3/bin:$PATH"
fi

if ! command -v ruby >/dev/null 2>&1 || ! command -v bundle >/dev/null 2>&1; then
  echo "Ruby 3.1+ and Bundler are required. On macOS: brew install ruby@3.3" >&2
  return 1
fi

ruby -e 'exit(Gem::Version.new(RUBY_VERSION) >= Gem::Version.new("3.1") ? 0 : 1)' || {
  echo "Ruby 3.1+ is required; found $(ruby -v)." >&2
  return 1
}
